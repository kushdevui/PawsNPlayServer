# Copy to .env and fill in real values. Never commit .env.
PORT=4000
# 0.0.0.0 lets phones on the same Wi-Fi reach the API; 127.0.0.1 = this computer only
HOST=0.0.0.0
# Reverse proxies in front of the API: 0 locally, 1 behind Nginx (EC2)
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/pawsnplay
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# bcrypt work factor for passwords (spec: 12)
BCRYPT_COST=12
# "*" = any origin (dev). In production use a comma-separated list, e.g. https://admin.example.com
CORS_ORIGINS=*
# Uploads: local (dev; saved in UPLOAD_DIR, served at /uploads) | s3 | cloudinary (not implemented yet)
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
# Optional: public origin for upload URLs (default: the host the request came in on)
# PUBLIC_BASE_URL=https://api.example.com
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CLOUDINARY_URL=
# Public "Know Your Dog" questionnaire: submissions per IP
QUESTIONNAIRE_RATE_PER_HOUR=5
QUESTIONNAIRE_RATE_PER_DAY=20
# development | test | production (npm start sets production)
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (default: info, silent in tests)
LOG_LEVEL=info
