    {
      "name": "Payments (admin)",
      "item": [
        {
          "name": "Record payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1800,\n  \"type\": \"advance\",\n  \"method\": \"upi\",\n  \"note\": \"50%\",\n  \"receivedAt\": \"2026-11-24T05:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns the full updated booking. type: advance | payment | refund; method: cash | upi | card | bank."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const payments = pm.response.json().data.payments;",
                  "if (payments.length) pm.collectionVariables.set('paymentId', payments[payments.length - 1].id);"
